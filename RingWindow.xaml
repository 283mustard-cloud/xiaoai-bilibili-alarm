<Window x:Class="XiaoAiAlarm.RingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="闹钟" Width="460" Height="330" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True">
  <Border Background="White" CornerRadius="14" Padding="34">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="闹钟" Foreground="{StaticResource AccentBrush}" FontSize="18" HorizontalAlignment="Center"/><TextBlock x:Name="AlarmTime" FontSize="58" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8"/><TextBlock x:Name="AlarmName" FontSize="21" HorizontalAlignment="Center"/></StackPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SnoozeButton" Content="贪睡 10 分钟" Margin="5" Click="Snooze_Click"/><Button Grid.Column="1" Content="停止" Style="{StaticResource PrimaryButton}" Margin="5" Click="Stop_Click"/></Grid>
    </Grid>
  </Border>
</Window>
