<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>XiaoAiAlarm</AssemblyName>
    <RootNamespace>XiaoAiAlarm</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\alarm.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Remove="Tests\**\*.cs"/><None Remove="Tests\**\*"/></ItemGroup>
  <ItemGroup><Resource Include="Assets\alarm.ico" /></ItemGroup>
</Project>
