<Window x:Class="XiaoAiAlarm.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="小爱闹钟" Width="1120" Height="680" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
      <Grid Margin="24,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◷" FontSize="26" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/><TextBlock Text="小爱闹钟" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button x:Name="SettingsButton" Content="设置" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Settings_Click"/></Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="ListPage" Margin="28,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="闹钟" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="每个闹钟由 Windows 独立唤醒和触发，关闭主窗口也会运行。" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,18"/></StackPanel><Button Content="＋ 新建闹钟" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Add_Click"/></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AlarmList"/></ScrollViewer>
      <Border Grid.Row="2" Background="#FFF8E8" BorderBrush="#F1D486" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="SystemStatus" Text="正在检查任务计划和音箱服务…" Foreground="#6A4B00" TextWrapping="Wrap"/></Border>
    </Grid>

    <Grid Grid.Row="1" x:Name="EditPage" Visibility="Collapsed" Margin="28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Button Content="← 返回" HorizontalAlignment="Left" Click="Back_Click"/><TextBlock x:Name="EditorTitle" Text="编辑闹钟" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        <Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel>
            <TextBlock Text="基本设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <TextBlock Text="名称"/><TextBox x:Name="NameBox" Margin="0,6,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="时间"/><TextBox x:Name="TimeBox" Margin="0,6,0,0" FontSize="22"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="重复"/><ComboBox x:Name="RepeatBox" Margin="0,6,0,0" SelectionChanged="Repeat_Changed"><ComboBoxItem Content="中国法定工作日" Tag="Workdays"/><ComboBoxItem Content="每天" Tag="Daily"/><ComboBoxItem Content="指定星期" Tag="Weekdays"/></ComboBox></StackPanel>
            </Grid>
            <WrapPanel x:Name="WeekdayPanel" Margin="0,14,0,0" Visibility="Collapsed"><CheckBox Content="一" Tag="Monday" Margin="6"/><CheckBox Content="二" Tag="Tuesday" Margin="6"/><CheckBox Content="三" Tag="Wednesday" Margin="6"/><CheckBox Content="四" Tag="Thursday" Margin="6"/><CheckBox Content="五" Tag="Friday" Margin="6"/><CheckBox Content="六" Tag="Saturday" Margin="6"/><CheckBox Content="日" Tag="Sunday" Margin="6"/></WrapPanel>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="贪睡（分钟）"/><TextBox x:Name="SnoozeBox" Text="10" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="闹钟音量（1–100）"/><TextBox x:Name="VolumeBox" Text="50" Margin="0,6,0,0"/></StackPanel></Grid>
          </StackPanel></Border>

          <Border Grid.Column="2" Background="White" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel>
            <TextBlock Text="铃声" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <ComboBox x:Name="SoundBox" SelectionChanged="Sound_Changed"><ComboBoxItem Content="B 站 UP 主最新投稿" Tag="BilibiliLatest"/><ComboBoxItem Content="指定 B 站视频" Tag="BilibiliVideo"/><ComboBoxItem Content="本地音频" Tag="LocalFile"/></ComboBox>
            <StackPanel x:Name="BiliPanel" Margin="0,14,0,0"><TextBlock x:Name="SourceLabel" Text="UP 主主页"/><TextBox x:Name="SourceBox" Margin="0,6,0,12"/><TextBlock x:Name="FilterLabel" Text="标题筛选（支持正则表达式）"/><TextBox x:Name="FilterBox" Margin="0,6,0,0"/></StackPanel>
            <Grid x:Name="LocalPanel" Margin="0,14,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LocalBox" IsReadOnly="True"/><Button Grid.Column="1" Content="选择文件" Click="Browse_Click"/></Grid>
            <StackPanel Margin="0,16,0,0"><TextBlock Text="提前更新（分钟）"/><TextBox x:Name="PrepareBox" Text="30" Width="160" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
            <Border Background="#F5F8FC" CornerRadius="8" Padding="12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PreparedInfo" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="打开文件夹" Click="OpenFolder_Click" Margin="12,0,0,0"/></Grid></Border>
            <TextBlock Text="B 站铃声缓存会自动清理，每个闹钟仅保留最近三期。" Foreground="{StaticResource SubtleBrush}" FontSize="12" Margin="0,10,0,0"/>
          </StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2"><StackPanel Orientation="Horizontal"><Button x:Name="DeleteButton" Content="删除" Foreground="#C42B1C" Click="Delete_Click"/><Button Content="立即更新" Click="UpdateNow_Click"/><Button Content="试听" Click="Test_Click"/><Button Content="停止音箱" Click="Stop_Click"/></StackPanel><Button Content="保存" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="Save_Click"/></Grid>
    </Grid>

    <ScrollViewer Grid.Row="1" x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <Grid Margin="28,22" MaxWidth="760" HorizontalAlignment="Center"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><Button Content="← 返回" HorizontalAlignment="Left" Click="Back_Click"/><TextBlock Text="连接设置" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,20"/></StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E2E2" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel>
          <TextBlock Text="XiaoMusic 地址"/><TextBox x:Name="XiaoUrlBox" Margin="0,6,0,14"/>
          <TextBlock Text="小爱音箱设备 ID"/><TextBox x:Name="DeviceBox" Margin="0,6,0,14"/>
          <TextBlock Text="XiaoMusic 启动脚本"/><TextBox x:Name="LauncherBox" Margin="0,6,0,14"/>
          <TextBlock Text="Python 路径（仅用于 XiaoMusic 与 yt-dlp，后台运行不显示窗口）"/><TextBox x:Name="PythonBox" Margin="0,6,0,14"/>
          <TextBlock Text="音频目录（必须是 XiaoMusic 的音乐目录）"/><TextBox x:Name="MediaBox" Margin="0,6,0,14"/>
          <TextBlock Text="yt-dlp.exe（留空则使用 Python 模块）"/><TextBox x:Name="YtDlpBox" Margin="0,6,0,14"/>
          <TextBlock Text="ffmpeg.exe（可选）"/><TextBox x:Name="FfmpegBox" Margin="0,6,0,0"/>
        </StackPanel></Border>
        <Button Grid.Row="2" Content="保存设置" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,16,0,25" Click="SaveSettings_Click"/>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
